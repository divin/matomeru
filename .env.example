# Matomeru runtime configuration (.env)
# Copy to .env and fill in your actual values. Required variables are
# enforced at startup; missing ones make the run exit 1 with a ConfigError.

# --- Sagashi MCP server (Reddit collection) ---
# Base URL of the running Sagashi MCP server (required)
SAGASHI_MCP_URL=
# Bearer token for Sagashi, if the server requires auth (optional)
SAGASHI_MCP_TOKEN=

# --- Notes MCP server (note delivery) ---
# Base URL of the running Notes MCP server (required)
NOTES_MCP_URL=
# Bearer token for the Notes MCP server, if it requires auth (optional)
NOTES_MCP_TOKEN=

# --- Local LLM endpoint (OpenAI-compatible chat completions) ---
# Base URL of the endpoint (required), e.g. http://localhost:8000/v1
LLM_BASE_URL=
# API key; local endpoints usually ignore it, defaults to "local" (optional)
LLM_API_KEY=
# Model name passed to the endpoint (required), e.g. qwen3:14b
LLM_MODEL=

# --- SMTP (digest email delivery) ---
# SMTP server hostname (required)
SMTP_HOST=
# SMTP port, integer (required). 465 = implicit TLS; otherwise STARTTLS
# is used when the server offers it.
SMTP_PORT=
# SMTP username; login only happens when set (optional)
SMTP_USER=
# SMTP password, never logged (optional)
SMTP_PASSWORD=
# Sender address, used for From and envelope sender (required)
SMTP_FROM=
# Comma-separated recipient addresses (required)
SMTP_TO=

# --- Time and state ---
# IANA timezone for the report date and local display (required),
# e.g. Europe/Berlin
TZ=
# Path to the SQLite state database (optional; default
# ~/.local/state/matomeru/state.sqlite3)
MATOMERU_STATE_DB=
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL (optional; default INFO)
MATOMERU_LOG_LEVEL=

# --- arXiv API ---
# Base URL of the arXiv Atom API (optional; default
# http://export.arxiv.org), mainly useful for testing
ARXIV_API_BASE=

# TODO: fill in the values marked (required) above before running.
